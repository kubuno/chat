<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; the real theming is Compose Material 3 (KubunoTheme).
         Status/nav bars are transparent since the map draws edge to edge. The
         status bar icons stay dark (light background) — the search pill floats
         over a light map. -->
    <style name="Theme.Kubuno" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
